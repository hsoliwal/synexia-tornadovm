# Example Java argfile for TornadoVM (OpenCL backend), for `java @example-argfile ...`
# invocations that don't go through the `tornado` launcher (see BUILD_AND_RUN.md,
# "Maven Build + Java with Argfile").
#
# Regenerated from a real jdk21/opencl build's `tornado --generate-argfile` output -
# do not hand-edit; the exact flags (module names, --enable-native-access, JVMCI
# exports) depend on the JDK and backends TornadoVM was built with, and go stale as
# both evolve. To refresh this file or produce one for other backends/JDKs:
#   source setvars.sh && tornado --generate-argfile
# then copy $TORNADOVM_HOME/tornado-argfile.template here (it already uses the
# ${TORNADOVM_HOME} placeholder below, so it works from any checkout).
#
# Expand ${TORNADOVM_HOME} (e.g. `envsubst < example-argfile > tornado.args`), then run:
#   java @tornado.args -m <module>/<Main-Class> [app args]

-server
-XX:+UnlockExperimentalVMOptions
-XX:+EnableJVMCI
--enable-preview
-Djava.library.path=${TORNADOVM_HOME}/lib
--module-path .:${TORNADOVM_HOME}/share/java/tornado
--upgrade-module-path ${TORNADOVM_HOME}/share/java/graalJars
-Dtornado.load.api.implementation=com.m3.tornado.runtime.tasks.TornadoTaskGraph
-Dtornado.load.runtime.implementation=com.m3.tornado.runtime.TornadoCoreRuntime
-Dtornado.load.tornado.implementation=com.m3.tornado.runtime.common.Tornado
-Dtornado.load.annotation.implementation=com.m3.tornado.annotation.ASMClassVisitor
-Dtornado.load.annotation.parallel=com.m3.tornado.api.annotations.Parallel
-XX:+UseParallelGC

# === common exports (Graal / JVMCI) ===
--add-opens java.base/java.lang=jdk.m3.tornado.runtime
--add-exports jdk.internal.vm.ci/jdk.vm.ci.common=jdk.m3.tornado.graal
--add-exports jdk.internal.vm.ci/jdk.vm.ci.meta=jdk.m3.tornado.runtime,jdk.m3.tornado.annotation,jdk.m3.tornado.drivers.common,jdk.m3.tornado.graal
--add-exports jdk.internal.vm.ci/jdk.vm.ci.code=jdk.m3.tornado.runtime,jdk.m3.tornado.drivers.common,jdk.m3.tornado.graal
--add-exports jdk.internal.vm.ci/jdk.vm.ci.runtime=jdk.m3.tornado.runtime
--add-opens jdk.internal.vm.ci/jdk.vm.ci.hotspot=jdk.m3.tornado.runtime
--add-exports jdk.internal.vm.ci/jdk.vm.ci.hotspot=jdk.m3.tornado.runtime
--add-exports jdk.internal.vm.ci/jdk.vm.ci.hotspot=jdk.m3.tornado.graal
--add-exports jdk.internal.vm.ci/jdk.vm.ci.meta=jdk.m3.tornado.graal
--add-exports jdk.internal.vm.ci/jdk.vm.ci.runtime=jdk.m3.tornado.graal
--add-exports jdk.internal.vm.ci/jdk.vm.ci.services=jdk.m3.tornado.graal
--add-exports jdk.internal.vm.ci/jdk.vm.ci.code=jdk.m3.tornado.graal
--add-exports org.graalvm.word/org.graalvm.word.impl=jdk.m3.tornado.graal
--add-exports org.graalvm.truffle.compiler/com.oracle.truffle.compiler=jdk.m3.tornado.graal
--add-exports org.graalvm.truffle.compiler/com.oracle.truffle.compiler.hotspot=jdk.m3.tornado.graal
--add-exports org.graalvm.truffle.compiler/com.oracle.truffle.compiler.hotspot.libgraal=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.aarch64=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.amd64=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.code=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.code.site=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.code.stack=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.common=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.hotspot=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.hotspot.aarch64=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.hotspot.amd64=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.hotspot.riscv64=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.meta=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.riscv64=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.runtime=jdk.m3.tornado.graal
--add-opens jdk.internal.vm.ci/jdk.vm.ci.services=jdk.m3.tornado.graal

# === native access (java.lang.foreign - every backend and library-task provider
# reaches its native library through tornado.runtime; see FFMSupport) ===
--enable-native-access=jdk.m3.tornado.runtime

# === opencl-exports ===
--add-opens java.base/java.lang=jdk.m3.tornado.drivers.opencl
--add-exports jdk.internal.vm.ci/jdk.vm.ci.common=jdk.m3.tornado.drivers.opencl
--add-exports jdk.internal.vm.ci/jdk.vm.ci.amd64=jdk.m3.tornado.drivers.opencl
--add-exports jdk.internal.vm.ci/jdk.vm.ci.meta=jdk.m3.tornado.drivers.opencl
--add-exports jdk.internal.vm.ci/jdk.vm.ci.code=jdk.m3.tornado.drivers.opencl
--add-exports jdk.internal.vm.ci/jdk.vm.ci.runtime=jdk.m3.tornado.drivers.opencl
--add-opens jdk.internal.vm.ci/jdk.vm.ci.hotspot=jdk.m3.tornado.drivers.opencl
--add-exports jdk.internal.vm.ci/jdk.vm.ci.hotspot=jdk.m3.tornado.drivers.opencl

--add-modules jdk.unsupported,java.management,java.logging,jdk.jfr,java.naming,jdk.management,jdk.m3.tornado.graal,jdk.m3.tornado.runtime,jdk.m3.tornado.annotation,jdk.m3.tornado.drivers.common,jdk.m3.tornado.drivers.opencl
